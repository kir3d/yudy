{
  "name": "yudy-cloudflare-backend",
  "private": true,
  "scripts": {
    "dev": "uvx --from workers-py pywrangler dev",
    "deploy": "uvx --from workers-py pywrangler deploy",
    "migrate:local": "wrangler d1 migrations apply yudy-production --local",
    "migrate:remote": "wrangler d1 migrations apply yudy-production --remote"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
