{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yudy-stats",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "stats.yudyai.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yudy-production",
      "database_id": "cad404ef-5d2b-46cd-b8e8-fcddfa942d12",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH",
      "id": "3b77688cce7041bf8e8ff0acb2f8adbd"
    }
  ],
  "observability": {
    "enabled": true
  }
}
