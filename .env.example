POSTGRES_DB=yudy
POSTGRES_USER=yudy
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://yudy:local-development-only@postgres:5432/yudy
REDIS_URL=redis://redis:6379/0
APP_ENV=development
# JSON array of explicit browser origins; native Android does not require CORS
CORS_ORIGINS=[]
JWT_SECRET=
JWT_ISSUER=yudy
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
# Optional: LEGAL_DOCUMENTS_PATH=/app/legal/manifest.json (container path)
# Optional: TAXONOMY_PATH=/app/taxonomy/manifest.json (container path)
# Optional: RISK_QUESTIONNAIRE_PATH=/app/risk/manifest.json (container path)
# Optional: DEMO_MARKET_PATH=/app/market/manifest.json (container path)

# Rule-based discovery personalization (JSON; unspecified weights keep defaults)
PERSONALIZATION_WEIGHTS={"sector_match":30,"theme_match":30,"region_match":15,"excluded_interest":-40,"disliked_similar":-30}
PERSONALIZATION_CACHE_SECONDS=120

# Optional custom education manifest
# LEARN_ARTICLES_PATH=/app/learn/manifest.json

# Demo provider URL reachable by the Android emulator; override for a physical device
BUY_PROVIDER_BASE_URL=http://10.0.2.2:8001
BUY_PROVIDER_NAME=Demo Provider
